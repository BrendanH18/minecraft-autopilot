{
  "name": "minecraft-agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local agent harness for your Minecraft Java player",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "fabric",
    "mineflayer",
    "baritone",
    "mcp",
    "agent",
    "ollama"
  ],
  "bin": {
    "mc-agent": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "lint:mod": "node scripts/gradle.js spotlessCheck",
    "format:mod": "node scripts/gradle.js spotlessApply",
    "setup:mod": "node scripts/setup-mod.js",
    "build:mod": "npm run setup:mod && node scripts/gradle.js build && node scripts/package-mod.js",
    "verify:mod": "node scripts/verify-mod.js",
    "dev:mod": "npm run setup:mod && node scripts/gradle.js runClient",
    "demo": "node src/cli.js demo",
    "acceptance:bot": "node scripts/live-bot-acceptance.js",
    "acceptance:fabric": "node scripts/live-bot-acceptance.js --backend fabric",
    "acceptance:fabric-fixtures": "node scripts/live-fabric-fixtures.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "uuid": "14.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.1.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "vec3": "0.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9"
  }
}
